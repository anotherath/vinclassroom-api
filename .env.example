# ======================================
# VinClassroom API Environment Variables
# ======================================

# Application
NODE_ENV=development
PORT=3000
API_PREFIX=api
CORS_ORIGIN=http://localhost:3000,http://localhost:5173

# ======================================
# Supabase
# Get these from: Supabase Dashboard > Project Settings > API
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ======================================
# Redis - External Server Configuration
# ======================================

# Option 1: Full URL (Recommended for external Redis)
# Format: redis://username:password@host:port/db hoặc rediss:// cho TLS
REDIS_URL=redis://localhost:6379
# REDIS_URL=redis://:your-password@your-redis-server.com:6379/0
# REDIS_URL=rediss://:your-password@your-redis-server.com:6380/0

# Option 2: Individual settings (fallback nếu không dùng URL)
# REDIS_HOST=your-redis-server.com
# REDIS_PORT=6379
# REDIS_PASSWORD=your-password
# REDIS_USERNAME=default  # optional
# REDIS_DB=0

# TLS/SSL Configuration (cho secure connections)
REDIS_TLS=false
# REDIS_TLS_REJECT_UNAUTHORIZED=true  # set false nếu dùng self-signed certificates

# Connection Settings
REDIS_MAX_RETRIES=3
REDIS_CONNECT_TIMEOUT=10000  # milliseconds

# ======================================
# JWT
# Generate strong secrets: openssl rand -base64 32
JWT_SECRET=your-super-secret-jwt-key-min-32-chars
JWT_REFRESH_SECRET=your-refresh-secret-key-min-32-chars
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d

# ======================================
# Rate Limiting
RATE_LIMIT_LOGIN_MAX=5
RATE_LIMIT_MESSAGE_MAX=30
RATE_LIMIT_API_MAX=100

# ======================================
# File Upload (Supabase Storage)
MAX_FILE_SIZE=10485760
ALLOWED_FILE_TYPES=image/*,application/pdf,application/msword,application/vnd.openxmlformats-officedocument.wordprocessingml.document

# ======================================
# Monitoring (Optional)
SENTRY_DSN=
LOG_LEVEL=debug

# Frontend URL (for emails, invites)
FRONTEND_URL=http://localhost:5173
